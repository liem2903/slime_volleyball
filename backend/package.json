{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express + TypeScript backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/setup/index.ts",
    "build": "tsc",
    "start": "node dist/setup/index.js",
    "test": "jest",
    "db:migrate": "set -a && . ./.env && set +a && psql \"$DATABASE_URL\" -f ../migrations/001_initial_schema.sql"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
